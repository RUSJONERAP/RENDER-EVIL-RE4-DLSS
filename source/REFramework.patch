+void TemporalUpscaler::on_lua_state_created(sol::state& lua) {
+    lua.new_usertype<TemporalUpscaler>("REFTemporalUpscaler",
+        "get", []() { return TemporalUpscaler::get().get(); },
+        "set_menu_bypass", &TemporalUpscaler::set_menu_bypass,
+        "is_menu_bypassed", &TemporalUpscaler::is_menu_bypassed,
+        "render_candidate_types", []() {
+            std::vector<std::string> names;
+            const auto db = sdk::RETypeDB::get();
+            if (db == nullptr) return names;
+            for (uint32_t i = 0; i < db->get_num_types() && names.size() < 512; ++i) {
+                const auto t = db->get_type(i);
+                if (t == nullptr) continue;
+                const auto name = t->get_full_name();
+                if ((name.starts_with("via.render.") || name.starts_with("via.gui.")) &&
+                    name.find('[') == std::string::npos && name.find('<') == std::string::npos &&
+                    (name.find("FSR") != std::string::npos || name.find("Upscal") != std::string::npos ||
+                     name.find("GUI") != std::string::npos || name.find("Gui") != std::string::npos ||
+                     name.find("Renderer") != std::string::npos || name.find("RenderTarget") != std::string::npos ||
+                     name.find("PrimitiveContext") != std::string::npos || name.find("DirectX") != std::string::npos)) names.push_back(name);
+            }
+            return names;
+        },
+        "render_layers", []() {
+            std::vector<std::string> rows;
+            std::unordered_set<sdk::renderer::RenderLayer*> seen;
+            std::function<void(sdk::renderer::RenderLayer*, uint32_t)> visit;
+            visit = [&](sdk::renderer::RenderLayer* layer, uint32_t depth) {
+                if (layer == nullptr || depth > 12 || seen.size() >= 256 || !seen.emplace(layer).second) return;
+                const auto type = utility::re_managed_object::get_type_definition(layer);
+                rows.push_back(std::string(depth * 2, ' ') + (type ? type->get_full_name() : "unknown") +
+                    " priority=" + std::to_string(layer->m_priority) + " output=" + std::to_string(layer->m_render_output_id));
+                for (auto child : layer->get_layers()) visit(child, depth + 1);
+            };
+            visit(sdk::renderer::get_root_layer(), 0);
+            return rows;
+        },
+        "menu_candidate_types", []() {
+            std::vector<std::string> names;
+            const auto db = sdk::RETypeDB::get();
+            if (db == nullptr) return names;
+            for (uint32_t i = 0; i < db->get_num_types() && names.size() < 256; ++i) {
+                const auto t = db->get_type(i);
+                if (t == nullptr) continue;
+                const auto name = t->get_full_name();
+                if (name.starts_with("chainsaw.") &&
+                    (name.find("Pause") != std::string::npos || name.find("GuiManager") != std::string::npos ||
+                     name.find("GuiMaster") != std::string::npos || name.find("MenuManager") != std::string::npos ||
+                     name.find("OptionManager") != std::string::npos)) names.push_back(name);
+            }
+            return names;
+        });
+}
+
+bool TemporalUpscaler::on_pre_gui_draw_element(REComponent* element, void* primitive_context) {
+    if (!m_hud_trace->value() || element == nullptr) return true;
+    // Metadata only. Do not reinterpret PrimitiveContext as RenderContext or change the GUI.
+    static std::mutex mutex;
+    static std::unordered_set<std::string> seen;
+    const auto go = utility::re_component::get_game_object(element);
+    if (go == nullptr) return true;
+    const auto name = utility::re_game_object::get_name(go);
+    const auto type = utility::re_managed_object::get_type_definition((::REManagedObject*)element);
+    const std::string type_name = type != nullptr ? type->get_full_name() : "unknown";
+    std::scoped_lock lock{mutex};
+    if (seen.size() < 512 && seen.emplace(type_name + ":" + name).second) {
+        const auto view = sdk::call_object_func_easy<REComponent*>(element, "get_View");
+        const auto view_type = view != nullptr ? sdk::call_object_func_easy<uint32_t>(view, "get_ViewType") : ~0u;
+        spdlog::info("[HUDLab] GUI name={} type={} context={:x} thread={} bypass={}",
+            name, type_name, (uintptr_t)primitive_context, GetCurrentThreadId(), m_menu_bypass.load());
+        spdlog::info("[HUDLab] GUI view={:x} viewType={} (screen/world classification)", (uintptr_t)view, view_type);
+    }
+    return true;
+}
+
+namespace {
+void trace_hud_target(const char* stage, sdk::renderer::TargetState* target) {
+    if (target == nullptr) return;
+    auto resource = target->get_native_resource_d3d12();
+    if (resource == nullptr) return;
+    const auto desc = resource->GetDesc();
+    const std::string key = std::string{stage} + ":" + std::to_string(desc.Width) + "x" +
+        std::to_string(desc.Height) + ":" + std::to_string((uint32_t)desc.Format);
+    static std::mutex mutex;
+    static std::unordered_set<std::string> seen;
+    std::scoped_lock lock{mutex};
+    if (seen.size() < 64 && seen.emplace(key).second) {
+        spdlog::info("[HUDLab] Target {} resource={:x} flags={:x} thread={}", key,
+            (uintptr_t)resource, (uint32_t)desc.Flags, GetCurrentThreadId());
+    }
+}
