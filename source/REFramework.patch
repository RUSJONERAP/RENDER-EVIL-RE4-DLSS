+void TemporalUpscaler::set_menu_bypass(bool active) {
+    if (VR::get()->is_hmd_active()) {
+        active = false; // This experiment is for the flat-screen RE4 route only.
+    }
+    if (m_menu_bypass.exchange(active) != active) {
+        m_history_reset.store(true);
+        spdlog::info("[HUDLab] Native menu bypass {} (SR settings retained)", active ? "on" : "off");
+    }
+}
